PORT_BROKER				= 1883
PORT_BROKER_WEBSOCKET	= 9001
PORT_CONTROLLER			= 5000
PORT_WEBVIEWER			= 8080

PORT_LOCAL_BROKER			= 1883
PORT_LOCAL_BROKER_WEBSOCKET	= 9001
PORT_LOCAL_CONTROLLER		= 5000
PORT_LOCAL_WEBVIEWER		= 8080


# URLs

HOST_BROKER				= "broker"

URL_BROKER				=	"tcp://${HOST_BROKER}:${PORT_BROKER}"
URL_BROKER_WEBSOCKET	=	"ws://broker:${PORT_BROKER_WEBSOCKET}"
URL_CONTROLLER			=	"http://controller:${PORT_CONTROLLER}"
URL_WEBVIEWER			=	"http://webviewer:${PORT_WEBVIEWER}"



# Endpoints


# MQTT Topics

TOPIC_CONTROLLER_STATUS				= "controller/status"
TOPIC_SYSCTRL_PREFIX				= "system/control"
TOPIC_SYSCTRL_BROADCAST_SUFFIX		= "broadcast"
TOPIC_VEHICLE_PREFIX				= "vehicle"
# /vehicle/collisions
TOPIC_VEHICLE_COLLISIONS_SUFFIX		= "collisions"
# /vehicle/+/<suffix>
TOPIC_VEHICLE_COMMAND_SUFFIX		= "command"
# each vehicle only shares positions and spatial data, to simulate local vision
TOPIC_VEHICLE_POSITION_SUFFIX		= "position"
TOPIC_VEHICLE_RESET_SUFFIX			= "reset"
# all telemetry (including positions)
TOPIC_VEHICLE_TELEMETRY_SUFFIX		= "telemetry"
# all telemetry (including positions) for all vehicles (including disconnected ones)
TOPIC_VEHICLE_TELEMETRY_ALL_SUFFIX	= "alltelemetry"
# each vehicle shares everything in its local vision
TOPIC_VEHICLE_VISION_SUFFIX			= "vision"


# Vars

DEBUG_MODE	= "false"
